# Internal service configuration only. Device credentials are supplied per
# operation by Laravel after decryption and must not be placed in this file.
NETWORK_AUTOMATION_SERVICE_NAME=network-automation
NETWORK_AUTOMATION_ENVIRONMENT=production
NETWORK_AUTOMATION_BIND_HOST=0.0.0.0
NETWORK_AUTOMATION_PORT=8000

# Inject the same long random value as backend NETWORK_AUTOMATION_TOKEN.
NETWORK_AUTOMATION_SERVICE_TOKEN=

NETWORK_AUTOMATION_SESSION_IDLE_TIMEOUT=300
NETWORK_AUTOMATION_SESSION_CONNECT_TIMEOUT=15
NETWORK_AUTOMATION_SESSION_COMMAND_TIMEOUT=30
NETWORK_AUTOMATION_SESSION_OVERALL_TIMEOUT=60
NETWORK_AUTOMATION_API_REQUEST_TIMEOUT=30
NETWORK_AUTOMATION_SNMP_REQUEST_TIMEOUT=5
NETWORK_AUTOMATION_WRITE_RETRIES=0

# Secure verification is the default. Change only for an explicitly isolated
# lab and document the exception in the deployment record.
NETWORK_AUTOMATION_HOST_KEY_VERIFICATION=true
NETWORK_AUTOMATION_TLS_VERIFICATION=true
NETWORK_AUTOMATION_LOG_REDACTION=true
